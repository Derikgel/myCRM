# Set DOMAIN in .env to your real domain (e.g. crm.example.com) to get
# automatic HTTPS via Let's Encrypt. Leave it empty and Caddy just serves
# plain HTTP on port 80. docker-compose.yml resolves the empty case to
# ":80" before it reaches this container; the :80 default below is just a
# second line of defense if Caddy is ever run without that.
{$DOMAIN:80} {
	encode gzip

	reverse_proxy app:80

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
	}
}
